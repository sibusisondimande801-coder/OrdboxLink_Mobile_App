{
  "expo": {
    "name": "OrdboxLink",
    "slug": "mzansilink",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.mzansilink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101C2C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mzansilink.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow OrdboxLink to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OrdboxLink to share photos and stories.",
          "cameraPermission": false
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "76d188b7-584f-494d-bc88-275fd1bbdd09"
      }
    },
    "owner": "raymondndimande"
  }
}
